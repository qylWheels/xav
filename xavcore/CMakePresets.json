{
    "version": 10,
    "configurePresets": [
        {
            "name": "vcpkg",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "packagePresets": [
        {
            "name": "xavcore-deb",
            "displayName": "Xavcore Debian Package",
            "description": "Xav core components Debian package",
            "configurePreset": "vcpkg",
            "generators": [
                "DEB"
            ]
        }
    ]
}